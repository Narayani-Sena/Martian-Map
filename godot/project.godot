; Engine configuration file.
; Godot 4.7 — Martian Map EVA Console (native client for the FastAPI backend in ../server)

config_version=5

[application]

config/name="Martian Map · EVA Console"
config/description="Native 3D interface for the Martian Map EVA planner: Gale crater boxwork, HiRISE terrain, helmet HUD."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.016, 0.02, 0.028, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Api="*res://scripts/core/api.gd"
Mission="*res://scripts/core/mission.gd"
Sfx="*res://scripts/core/sfx.gd"
CW="*res://scripts/core/cw.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true
theme/default_font_antialiasing=1
theme/lcd_subpixel_layout=0

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.016, 0.02, 0.028, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=2

[shader_globals]

ribbon_px_k={
"type": "float",
"value": 0.0015
}
